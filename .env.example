# Copy this file to .env and fill in the values. NEVER commit .env.
# Share real keys with the team privately (team chat), not on GitHub.

# FIRMS API key (free). Request it with "Get MAP_KEY" on https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# Where downloaded and processed data lives (several GB).
# Keep it OUTSIDE OneDrive / Dropbox / Google Drive, or it will try to sync everything.
DATA_DIR=C:/fire-data

# API server (infra/api)
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Website -> API address (web/)
VITE_API_BASE_URL=http://localhost:8000
