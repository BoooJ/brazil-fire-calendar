# ---------- Data: never commit (several GB). Rebuild with the scripts in infra/ ----------
data/*
!data/.gitkeep
*.zip
*.parquet
*.csv
*.shp
*.dbf
*.shx
*.prj
*.duckdb
*.duckdb.wal
# ...except the small fake files the website is built against
!web/mocks/*.csv
# ...and the forecast model's lookup tables (science/forecast/artefatos, ~18 MB)
!science/forecast/artefatos/*.parquet

# ---------- Secrets: never commit ----------
.env
.env.*
!.env.example

# Safety net: files that usually hold keys or passwords (any folder, any case)
*[Aa][Pp][Ii]*[Kk][Ee][Yy]*
*[Mm][Aa][Pp]*[Kk][Ee][Yy]*
*[Ss][Ee][Cc][Rr][Ee][Tt]*
*[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]*
*[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]*
*[Tt][Oo][Kk][Ee][Nn]*.txt
*.pem
*.key
*.p12
*.pfx
.netrc
_netrc

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# ---------- Node / website build ----------
node_modules/
dist/
.vite/

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
